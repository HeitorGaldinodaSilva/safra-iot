# ---- Copie para ".env" e preencha. NUNCA suba o .env para o Git (RNF02) ----

# ThingSpeak (os mesmos valores que já estão no .env do Backend Node)
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=
THINGSPEAK_FIELD_TEMP=field1
THINGSPEAK_FIELD_UMID=field2
THINGSPEAK_OFFLINE_MIN=15

# INMET: estação automática de Petrolina-PE = A307.
# Os dados horários exigem TOKEN do INMET (solicite em https://portal.inmet.gov.br).
INMET_ESTACAO=A307
INMET_TOKEN=

# Open-Meteo (fonte de clima usada quando não há INMET_TOKEN ou quando o INMET falha).
# Estimativa de modelo para a coordenada abaixo (padrão: Petrolina-PE). Troque pela localização dos sensores.
OPEN_METEO_LAT=-9.39
OPEN_METEO_LON=-40.5

# Autenticação (RF08): o FastAPI pergunta ao Backend Node se o token é válido
# e se o perfil é permitido. Em desenvolvimento pode usar AUTH_ATIVA=false.
AUTH_ATIVA=true
NODE_API_URL=http://localhost:3001
PERFIS_PERMITIDOS=analista
PERFIS_PRODUTOR=produtor      # quem acessa GET /produtor/clima (dashboard do Produtor, via Open-Meteo)

# CORS (separe por vírgula). Vazio = libera apenas localhost/127.0.0.1 em qualquer porta.
CORS_ORIGINS=

# Limiares dos alertas (valores PROVISÓRIOS: valide com a orientação/agrônomo)
LIMITE_DIVERGENCIA_TEMP=5
LIMITE_QUALIDADE_GERAL=90
JANELA_TEMP_MIN=18
JANELA_TEMP_MAX=32
JANELA_UMID_MIN=40
JANELA_UMID_MAX=75

# ---- Modelos (fase 1) ----
# O FastAPI usa os mesmos DB_HOST/DB_USER/DB_PASSWORD/DB_NAME/DB_PORT do Backend Node.
ANOS_TREINO=5               # anos de histórico do Open-Meteo usados no treino
MODELO_VALIDADE_DIAS=14     # depois disso o modelo aparece como "Retreino recomendado"
KC_CULTURA=0.8              # coeficiente de cultura da irrigação (PROVISÓRIO: valide com a orientação)
COLHEITA_CULTIVAR=syrah     # cultivar padrão do modelo de colheita: syrah ou cabernet_sauvignon

# ---- Controles de segurança (2FA com OTP e IDOR) ----
CODIGO_MISSAO=               # código de 6 caracteres enviado pelo professor (aparece nos logs de bloqueio)
TOTP_CHAVE=                  # 64 caracteres hexadecimais; cifra o segredo TOTP no banco. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_JANELA=1                 # passos de 30 s aceitos para cada lado do relógio (0 = só o passo atual)
DOIS_FATORES=on              # "off" só para o teste do ANTES
PROTECAO_IDOR=on             # "off" só para o teste do ANTES
