# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3001

# Chave que o ESP32 envia no cabeçalho X-API-Key (gere uma aleatória, ex.: 32+ caracteres)
ESP32_API_KEY=troque-por-uma-chave-longa-e-aleatoria
# Minutos sem dados para considerar o ESP32 offline
LEITURAS_OFFLINE_MIN=5

THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=
THINGSPEAK_FIELD_TEMP=field1
THINGSPEAK_FIELD_UMID=field2
OPEN_METEO_LAT=-9.39
OPEN_METEO_LON=-40.5
PRODUTO_PADRAO=uva
PAM_MUNICIPIOS=2611101
COMEX_UFS=26,29
CODIGO_MISSAO=
TOTP_CHAVE=

# true = GET /api/leituras* abertos (demonstracao/PWA). O POST do ESP32 sempre exige a chave.
LEITURAS_GET_PUBLICO=true
